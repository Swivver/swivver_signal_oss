{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swivver.ai/schemas/signal/profile-1.0",
  "title": "Signal technical shadow profile 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "method_bundle",
    "subject",
    "state",
    "mode",
    "review_state",
    "signals",
    "evidence",
    "flags",
    "coverage",
    "thresholds",
    "tools",
    "generated_at",
    "runtime_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "signal-profile/1.0"
    },
    "method_bundle": {
      "const": "ffmpeg-technical-v1"
    },
    "subject": {
      "type": "object",
      "required": [
        "snapshot_id",
        "input_sha256",
        "media_sha256"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "state": {
      "const": "partial"
    },
    "mode": {
      "const": "shadow"
    },
    "review_state": {
      "const": "unreviewed"
    },
    "signals": {
      "type": "array",
      "minItems": 20,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "signal_id",
          "kind",
          "status",
          "value",
          "unit_or_scale",
          "method_id",
          "confidence",
          "evidence_ids",
          "limitations"
        ],
        "properties": {
          "signal_id": {
            "enum": [
              "media.modality",
              "media.duration",
              "media.width",
              "media.height",
              "media.aspect_ratio",
              "media.exif",
              "media.audio_track_count",
              "accessibility.embedded_caption_track_count",
              "accessibility.flash_segments",
              "accessibility.max_flash_rate_hz",
              "technical.black_segments",
              "technical.static_segments",
              "technical.silent_segments",
              "technical.mean_volume",
              "technical.max_volume",
              "attention.cuts_per_min",
              "attention.opening_3s_cut_count",
              "attention.cut_acceleration",
              "attention.loop_frame_similarity",
              "attention.audio_peak_rms_delta_db",
              "attention.audio_loudness_range_lu",
              "provenance.c2pa",
              "provenance.perceptual_hash",
              "safety",
              "age_suitability",
              "synthetic_media",
              "identity",
              "advertising_integrity",
              "claim_support",
              "rights",
              "provenance",
              "caption_completeness",
              "attention_design"
            ]
          },
          "kind": {
            "enum": [
              "measurement",
              "risk"
            ]
          },
          "status": {
            "enum": [
              "measured",
              "unsupported",
              "not_applicable"
            ]
          },
          "value": {
            "type": [
              "number",
              "string",
              "object",
              "null"
            ]
          },
          "unit_or_scale": {
            "type": [
              "string",
              "null"
            ]
          },
          "method_id": {
            "enum": [
              "ffmpeg-technical-v1",
              "c2pa-jumbf-v1",
              "dhash-9x8-v1",
              null
            ]
          },
          "confidence": {
            "type": "object",
            "required": [
              "status",
              "probability",
              "calibration_id"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_applicable",
                  "uncalibrated"
                ]
              },
              "probability": {
                "type": "null"
              },
              "calibration_id": {
                "type": "null"
              }
            },
            "additionalProperties": false
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "media_sha256",
          "modality",
          "start_seconds",
          "end_seconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "media_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "modality": {
            "enum": [
              "video",
              "audio",
              "image"
            ]
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 600.1
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 600.1
          }
        },
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "signal_id",
          "evidence_ids",
          "review_state",
          "automatic_action",
          "interpretation"
        ],
        "properties": {
          "code": {
            "enum": [
              "black_frames_observed",
              "static_frames_observed",
              "silence_observed",
              "photosensitive_flash_observed",
              "c2pa_tampered_payload"
            ]
          },
          "signal_id": {
            "enum": [
              "media.modality",
              "media.duration",
              "media.width",
              "media.height",
              "media.aspect_ratio",
              "media.exif",
              "media.audio_track_count",
              "accessibility.embedded_caption_track_count",
              "accessibility.flash_segments",
              "accessibility.max_flash_rate_hz",
              "technical.black_segments",
              "technical.static_segments",
              "technical.silent_segments",
              "technical.mean_volume",
              "technical.max_volume",
              "attention.cuts_per_min",
              "attention.opening_3s_cut_count",
              "attention.cut_acceleration",
              "attention.loop_frame_similarity",
              "attention.audio_peak_rms_delta_db",
              "attention.audio_loudness_range_lu",
              "provenance.c2pa",
              "provenance.perceptual_hash",
              "safety",
              "age_suitability",
              "synthetic_media",
              "identity",
              "advertising_integrity",
              "claim_support",
              "rights",
              "provenance",
              "caption_completeness",
              "attention_design"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "review_state": {
            "const": "unreviewed"
          },
          "automatic_action": {
            "const": "none"
          },
          "interpretation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object"
    },
    "thresholds": {
      "type": "object"
    },
    "tools": {
      "type": "object"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_seconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
