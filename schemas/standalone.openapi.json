                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Request rejected; no private media URL or source text is returned in errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Media must be 1\u2013536870912 bytes with Content-Length"
          },
          "507": {
            "description": "Storage capacity exhausted"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Content-SHA256",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ]
      }
    },
    "/v1/assessments": {
      "post": {
        "summary": "Enqueue an independent durable assessment",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "created_at": {
                      "type": "number"
                    },
                    "method_bundle": {
                      "type": "string"
                    },
                    "mode": {
                      "const": "shadow"
                    }
                  },
                  "required": [
                    "id",
                    "created_at",
                    "method_bundle",
                    "mode"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; no private media URL or source text is returned in errors.",
            "content": {
              "application/json": {
