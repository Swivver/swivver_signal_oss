    "/v1/assessments/{id}": {
      "get": {
        "summary": "Read a caller-owned job and optional result",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "state": {
                      "enum": [
                        "queued",
                        "running",
                        "completed",
                        "failed"
                      ]
                    },
                    "attempts": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "created_at": {
                      "type": "number"
                    },
                    "started_at": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "finished_at": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "error_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "profile": {
                      "oneOf": [
                        {
                          "oneOf": [
                            {
                              "type": "object",
                              "required": [
                                "schema_version",
                                "subject",
                                "signals",
                                "evidence",
                                "flags"
                              ],
                              "properties": {
                                "schema_version": {
                                  "const": "signal-profile/0.1"
                                }
                              }
                            },
                            {
                              "$ref": "#/components/schemas/EvidenceProfile"
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "state",
                    "attempts",
                    "created_at",
                    "started_at",
                    "finished_at",
                    "error_code",
                    "profile"
                  ]
                }
              }
            }
          },
          "401": {
