        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "method_bundle": {
                        "const": "ffmpeg-technical-v1",
                        "default": "ffmpeg-technical-v1"
                      },
                      "binding": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "snapshot_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "input_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "snapshot_id",
                          "input_sha256"
                        ]
                      },
                      "asset_id": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{32}$"
                      },
                      "media": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "maxLength": 4096
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "size_bytes": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 536870912
                          }
                        },
                        "required": [
                          "url",
                          "sha256",
                          "size_bytes"
                        ]
                      }
                    },
                    "required": [],
                    "oneOf": [
                      {
                        "required": [
                          "asset_id"
                        ]
                      },
                      {
                        "required": [
                          "media"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "method_bundle": {
                        "const": "source-evidence-nli-v1"
                      },
                      "binding": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "snapshot_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "input_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "snapshot_id",
                          "input_sha256"
                        ]
                      },
                      "language": {
                        "const": "en"
                      },
                      "claims": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4000
                            },
                            "evidence": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "source_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200
                                  },
                                  "start_offset": {
                                    "type": "integer",
                                    "minimum": 0
                                  },
                                  "end_offset": {
                                    "type": "integer",
                                    "minimum": 1
                                  }
                                },
                                "required": [
                                  "source_id",
                                  "start_offset",
                                  "end_offset"
                                ],
                                "description": "Offsets are Unicode code points into the exact source text, end-exclusive."
                              },
                              "minItems": 0,
                              "maxItems": 20
                            }
                          },
                          "required": [
                            "id",
                            "text"
                          ]
                        },
                        "minItems": 1,
                        "maxItems": 20
                      },
                      "sources": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "revision_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64000
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
                            "url": {
                              "type": "string",
                              "maxLength": 4096
                            },
                            "retrieved_at": {
                              "type": "string",
                              "maxLength": 4096
                            }
                          },
                          "required": [
                            "id",
                            "revision_id",
                            "text"
                          ]
                        },
                        "minItems": 1,
                        "maxItems": 20
                      }
                    },
                    "required": [
                      "method_bundle",
                      "language",
                      "claims",
                      "sources"
                    ],
                    "description": "Optional installed local model. Supplied English passages only, at most 400,000 total source code points; over-budget model pairs abstain."
                  }
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "Same caller, key and semantic input replay one job. A different input conflicts. Renewed signed URLs do not alter media identity."
          }
        ]
      }
    },
