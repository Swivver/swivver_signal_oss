{
  "openapi": "3.1.0",
  "info": {
    "title": "Swivver Signal standalone API",
    "version": "0.2.0",
    "description": "Independent uploads, identities, durable SQLite jobs and shadow results. Core is an optional client. Numerical confidence and automatic enforcement are not provided."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/assets": {
      "post": {
        "summary": "Upload binary media; content is hashed and caller-scoped",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "size_bytes": {
                      "type": "integer"
                    },
                    "created_at": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "sha256",
                    "size_bytes",
                    "created_at"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; no private media URL or source text is returned in errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; no private media URL or source text is returned in errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Request rejected; no private media URL or source text is returned in errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Request rejected; no private media URL or source text is returned in errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
